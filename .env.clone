# ==============================================================================
# MC-Desk Master Environment Variables (TEMPLATE / CLONE)
# Copia este archivo a ".env" en la raíz si ejecutas herramientas globales,
# o copia los archivos individuales en backend/.env.clone y frontend/.env.clone
# ¡NUNCA SUBAS ARCHIVOS .env CON CREDENCIALES REALES A GITHUB!
# ==============================================================================

# ------------------------------------------------------------------------------
# BACKEND CONFIGURATION (RENDER / CLOUD READY)
# ------------------------------------------------------------------------------
PORT=3000
NODE_ENV=development
DATABASE_URL=
JWT_SECRET=tu_clave_secreta_jwt_muy_segura_aqui_64_caracteres
JWT_EXPIRES_IN=7d
AGENT_SHARED_SECRET=tu_secreto_compartido_para_server_agent_aqui
FRONTEND_ORIGIN=http://localhost:5173

# ------------------------------------------------------------------------------
# MINECRAFT SERVER AGENT API (100% SSH-FREE)
# ------------------------------------------------------------------------------
# La comunicación servidor <-> nube se realiza exclusivamente mediante HTTPS
# desde el MC-Desk Agent (agent.py) hacia el backend en Render.
# No requiere abrir puertos SSH (22), ni claves privadas ni contraseñas.
MC_SERVER_NAME=Mi Servidor Minecraft
MC_MINECRAFT_PUBLIC_IP=mc.tudominio.com

# ------------------------------------------------------------------------------
# FRONTEND CONFIGURATION
# ------------------------------------------------------------------------------
VITE_API_URL=http://localhost:3000
VITE_MC_DEFAULT_HOST=mc.tudominio.com
