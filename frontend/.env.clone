# ==============================================================================
# MC-Desk Frontend Environment Variables (TEMPLATE / CLONE)
# Copia este archivo a ".env" y reemplaza los valores según tu despliegue.
# ¡NUNCA SUBAS TU ARCHIVO .env REAL AL REPOSITORIO GIT!
# ==============================================================================

# URL base del Backend MC-Desk API
# Desarrollo local: http://localhost:3000
# Producción (ej. Render): https://mc-desk-api.onrender.com
VITE_API_URL=http://localhost:3000

# Host o IP pública por defecto mostrada en el panel
VITE_MC_DEFAULT_HOST=mc.tudominio.com
