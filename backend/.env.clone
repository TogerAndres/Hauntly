# ==============================================================================
# MC-Desk Backend Environment Variables (TEMPLATE / CLONE)
# Copia este archivo a ".env" y reemplaza los valores según tu infraestructura.
# ¡NUNCA SUBAS TU ARCHIVO .env REAL AL REPOSITORIO GIT!
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Configuración del Servidor HTTP / API
# ------------------------------------------------------------------------------
PORT=3000
NODE_ENV=development

# ------------------------------------------------------------------------------
# 2. Base de Datos (PostgreSQL / Supabase / Neon / Render Postgres)
# Deja en blanco para usar el modo de desarrollo en memoria persistente (store.json)
# Ejemplo: postgresql://postgres:[PASSWORD]@[HOST]:5432/postgres?sslmode=require
# ------------------------------------------------------------------------------
DATABASE_URL=

# ------------------------------------------------------------------------------
# 3. Seguridad y Tokens JWT
# Genera claves seguras aleatorias para producción (ej: openssl rand -hex 32)
# ------------------------------------------------------------------------------
JWT_SECRET=tu_clave_secreta_jwt_muy_segura_aqui_64_caracteres
JWT_EXPIRES_IN=7d
AGENT_SHARED_SECRET=tu_secreto_compartido_para_server_agent_aqui

# ------------------------------------------------------------------------------
# 4. Origen Permitido para CORS
# Desarrollo local: http://localhost:5173
# Producción: https://tu-dominio-frontend.com
# ------------------------------------------------------------------------------
FRONTEND_ORIGIN=http://localhost:5173

# ------------------------------------------------------------------------------
# 5. Conectividad Cloud y Agent API (100% SSH-FREE)
# Conexión outbound HTTPS desde el daemon Python del servidor hacia la API en Render.
# No requiere abrir puertos SSH ni exponer contraseñas del sistema.
# ------------------------------------------------------------------------------
MC_SERVER_NAME=Mi Servidor Minecraft
MC_MINECRAFT_PUBLIC_IP=mc.tudominio.com
