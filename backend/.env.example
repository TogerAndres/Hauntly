# ==============================================================================
# MC-Desk Backend Environment Variables (TEMPLATE / CLONE)
# Copia este archivo a ".env" y reemplaza los valores según tu infraestructura.
# ¡NUNCA SUBAS TU ARCHIVO .env REAL AL REPOSITORIO GIT!
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Configuración del Servidor HTTP / API
# ------------------------------------------------------------------------------
PORT=3000
NODE_ENV=development

# ------------------------------------------------------------------------------
# 2. Base de Datos (PostgreSQL / Supabase)
# Deja en blanco para usar el modo de desarrollo en memoria (In-Memory Mock)
# Ejemplo Supabase: postgresql://postgres:[PASSWORD]@[HOST]:6543/postgres?pgbouncer=true
# ------------------------------------------------------------------------------
DATABASE_URL=

# ------------------------------------------------------------------------------
# 3. Seguridad y Tokens JWT
# Genera claves seguras aleatorias para producción
# ------------------------------------------------------------------------------
JWT_SECRET=tu_clave_secreta_jwt_muy_segura_aqui_64_caracteres
JWT_EXPIRES_IN=7d
AGENT_SHARED_SECRET=tu_secreto_compartido_para_server_agent_aqui

# ------------------------------------------------------------------------------
# 4. Origen Permitido para CORS
# Desarrollo local: http://localhost:5173
# Producción: https://tu-dominio-frontend.com
# ------------------------------------------------------------------------------
FRONTEND_ORIGIN=http://localhost:5173

# ------------------------------------------------------------------------------
# 5. Puente SSH / Acceso al Servidor Minecraft Remoto
# Si utilizas el modo bridge SSH directo hacia tu VPS/servidor dedicado:
# ------------------------------------------------------------------------------
MC_REMOTE_HOST=192.168.1.100
MC_REMOTE_USER=mcadmin
MC_REMOTE_PASS=tu_contraseña_ssh_o_vps
MC_SERVER_DIR=/home/mcadmin/minecraft
MC_BACKUPS_DIR=/home/mcadmin/backups
MC_COLLECTOR_SCRIPT=/home/mcadmin/mc_desk_collector.py
MC_SOCKET_PATH=/tmp/ssh_mux_mcserver

# ------------------------------------------------------------------------------
# 6. Datos Públicos del Servidor Minecraft (Opcional)
# ------------------------------------------------------------------------------
MC_SERVER_NAME=Mi Servidor Minecraft
MC_MINECRAFT_PUBLIC_IP=mc.tudominio.com
