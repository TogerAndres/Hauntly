# ==============================================================================
# MC-Desk Git Ignore Rules
# ==============================================================================

# 1. Environments, Credentials and Secrets (CRITICAL: NEVER COMMIT REAL SECRETS)
.env
.env.*
.env.local
.env.development
.env.development.local
.env.test
.env.test.local
.env.production
.env.production.local
*.env
backend/.env
frontend/.env

# Whitelist environment templates
!.env.example
!.env.clone
!.env.template
!backend/.env.example
!backend/.env.clone
!backend/.env.template
!frontend/.env.example
!frontend/.env.clone
!frontend/.env.template

# 2. Node Dependencies and Package Manager Logs
node_modules/
backend/node_modules/
frontend/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# 3. Production Builds and Output Artifacts
dist/
dist-ssr/
build/
out/
.cache/
frontend/dist/
frontend/build/

# 4. Server Agent Runtime, Cache and Local Configs
server-agent/config.json
server-agent/*.log
server-agent/__pycache__/
*.py[cod]
*$py.class
__pycache__/
.pytest_cache/

# 5. Logs, Sockets, and Temporary Runtime Files
logs/
*.log
*.sqlite
*.sqlite3
*.logarchive/
*.tracev3
/tmp/ssh_mux_*
/tmp/mc_idle_minutes
*.sock

# 6. Operating System and IDE Artifacts
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
*.swp
*.swo
*~
